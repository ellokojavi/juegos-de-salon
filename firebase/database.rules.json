{
  "rules": {
    "rooms": {
      ".read": "auth != null && auth.uid === 'TrNylkeOFXNhnTPWAApebKvbI3F2'",
      ".indexOn": ["createdAt"],
      "$room": {
        ".read": "$room.matches(/^[A-Z]{4}$/)",
        ".write": "$room.matches(/^[A-Z]{4}$/) && data.exists() && !newData.exists() && data.child('createdAt').val() < now - 21600000",
        ".validate": "newData.hasChildren(['createdAt', 'game'])",
        "createdAt": {
          ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
        },
        "game": {
          ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists()",
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "config": {
          ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists()",
          ".validate": "newData.hasChildren()"
        },
        "players": {
          "$p": {
            ".write": "$room.matches(/^[A-Z]{4}$/) && $p.matches(/^[A-F]$/) && root.child('rooms/' + $room + '/createdAt').val() > now - 21600000",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "messages": {
          "$id": {
            ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists() && root.child('rooms/' + $room + '/createdAt').val() > now - 21600000",
            ".validate": "newData.hasChildren(['t', 'from', 'at']) && newData.child('t').isString() && newData.child('t').val().length < 20 && newData.child('from').val().matches(/^[A-F]$/) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && (!newData.hasChild('text') || (newData.child('text').isString() && newData.child('text').val().length <= 200))"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "cleanup": {
      "sweptDay": {
        ".read": true,
        ".write": "newData.isNumber() && newData.val() * 86400000 <= now && (!data.exists() || newData.val() > data.val())"
      },
      "days": {
        "$day": {
          ".read": "!data.exists() || data.child('lastAt').val() < now - 21600000",
          ".write": "data.exists() && !newData.exists() && data.child('lastAt').val() < now - 21600000",
          ".validate": "newData.hasChildren(['lastAt'])",
          "lastAt": {
            ".write": "newData.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
          },
          "rooms": {
            "$code": {
              ".write": "$code.matches(/^[A-Z]{4}$/) && !data.exists()",
              ".validate": "newData.isBoolean() && newData.val() == true"
            }
          },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },
    "stats": {
      ".read": "auth != null && auth.uid === 'TrNylkeOFXNhnTPWAApebKvbI3F2'",
      "$env": {
        ".validate": "$env.matches(/^(prod|lab|dev)$/)",
        "days": {
          "$day": {
            ".validate": "$day.matches(/^[0-9]{5}$/)",
            "rooms": {
              "$code": {
                ".write": "$env.matches(/^(prod|lab|dev)$/) && $day.matches(/^[0-9]{5}$/) && $code.matches(/^[A-Z]{4}$/) && !data.exists()",
                ".validate": "newData.hasChildren(['game', 'at', 'v', 'players'])",
                "game": { ".validate": "newData.isString() && newData.val().length < 40" },
                "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000" },
                "v": { ".validate": "newData.isString() && newData.val().length <= 16" },
                "players": {
                  "$p": {
                    ".write": "$env.matches(/^(prod|lab|dev)$/) && $day.matches(/^[0-9]{5}$/) && $code.matches(/^[A-Z]{4}$/) && $p.matches(/^[A-F]$/) && !data.exists()",
                    ".validate": "newData.isString() && newData.val().length <= 20"
                  }
                },
                "$other": { ".validate": false }
              }
            },
            "local": {
              "$game": {
                "$mode": {
                  "$n": {
                    ".write": "$env.matches(/^(prod|lab|dev)$/) && $day.matches(/^[0-9]{5}$/) && $game.matches(/^[a-z-]{1,40}$/) && $mode.matches(/^(local|cpu|solo)$/) && $n.matches(/^[1-6]$/)",
                    ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
                  }
                }
              }
            },
            "origin": {
              "$tz": {
                ".write": "$env.matches(/^(prod|lab|dev)$/) && $day.matches(/^[0-9]{5}$/) && $tz.matches(/^[A-Za-z0-9_+-]{1,40}$/)",
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
              }
            },
            "lang": {
              "$lang": {
                ".write": "$env.matches(/^(prod|lab|dev)$/) && $day.matches(/^[0-9]{5}$/) && $lang.matches(/^[A-Za-z0-9_-]{1,12}$/)",
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
              }
            },
            "hour": {
              "$h": {
                ".write": "$env.matches(/^(prod|lab|dev)$/) && $day.matches(/^[0-9]{5}$/) && $h.matches(/^([0-9]|1[0-9]|2[0-3])$/)",
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
