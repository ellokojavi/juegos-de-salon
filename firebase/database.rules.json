            ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && $subId.matches(/^[0-9a-f]{32}$/) && root.child('torneoSeats/' + $code + '/' + $pid + '/' + auth.uid).exists() && (!newData.exists() || newData.parent().parent().parent().parent().child('push/' + $subId + '/uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['dia', 'plazo', 'at']) && newData.child('dia').isBoolean() && newData.child('plazo').isBoolean() && newData.child('at').isNumber() && newData.child('at').val() <= now",
            "$otro": {
              ".validate": "$otro === 'dia' || $otro === 'plazo' || $otro === 'at'"
            }
          }
        }
      }
    },
    "pushEnviados": {
      ".read": false,
      ".write": false
    },
    "pushDia": {
      "$subId": {
        ".read": false,
        ".write": "auth != null && $subId.matches(/^[0-9a-f]{32}$/) && (root.child('push/' + $subId + '/uid').val() === auth.uid || newData.parent().parent().child('push/' + $subId + '/uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['h', 'at'])",
        "h": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"
        },
        "d": {
          ".validate": "newData.isBoolean()"
        },
        "r": {
          ".validate": "newData.isBoolean()"
        },
        "w": {
          ".validate": "newData.isBoolean()"
        },
        "u": {
          ".validate": "newData.isNumber() && newData.val() >= 10000 && newData.val() <= 99999"
        },
        "c": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "k": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
        },
        "m": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "sp": {
          ".validate": "newData.isString() && newData.val().matches(/^s[0-9]{4}-[0-9]{2}$/)"
        },
        "sn": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "pushEnviadosDia": {
      ".read": false,
      ".write": false
    }
  }
}
