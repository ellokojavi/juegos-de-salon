{
  "rules": {
    "rooms": {
      ".read": "auth != null && auth.uid === 'TrNylkeOFXNhnTPWAApebKvbI3F2'",
      ".indexOn": [
        "createdAt"
      ],
      "$room": {
        ".read": "$room.matches(/^[A-Z]{4}$/)",
        ".write": "$room.matches(/^[A-Z]{4}$/) && data.exists() && !newData.exists() && (data.child('createdAt').val() < now - 21600000 || (data.child('lastAt').exists() && data.child('lastAt').val() < now - 1800000) || (data.child('players').hasChildren() && (!data.child('players/A').exists() || data.child('players/A/left').val() == true) && (!data.child('players/B').exists() || data.child('players/B/left').val() == true) && (!data.child('players/C').exists() || data.child('players/C/left').val() == true) && (!data.child('players/D').exists() || data.child('players/D/left').val() == true) && (!data.child('players/E').exists() || data.child('players/E/left').val() == true) && (!data.child('players/F').exists() || data.child('players/F/left').val() == true)))",
        ".validate": "newData.hasChildren(['createdAt', 'game'])",
        "createdAt": {
          ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
        },
        "lastAt": {
          ".write": "$room.matches(/^[A-Z]{4}$/) && root.child('rooms/' + $room + '/createdAt').val() > now - 21600000 && (!root.child('rooms/' + $room + '/lastAt').exists() || root.child('rooms/' + $room + '/lastAt').val() > now - 1800000)",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
        },
        "game": {
          ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists()",
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "config": {
          ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists()",
          ".validate": "newData.hasChildren()"
        },
        "players": {
          "$p": {
            ".write": "$room.matches(/^[A-Z]{4}$/) && $p.matches(/^[A-F]$/) && root.child('rooms/' + $room + '/createdAt').val() > now - 21600000 && (!root.child('rooms/' + $room + '/lastAt').exists() || root.child('rooms/' + $room + '/lastAt').val() > now - 1800000)",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20",
            "left": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "messages": {
          "$id": {
            ".write": "$room.matches(/^[A-Z]{4}$/) && !data.exists() && root.child('rooms/' + $room + '/createdAt').val() > now - 21600000 && (!root.child('rooms/' + $room + '/lastAt').exists() || root.child('rooms/' + $room + '/lastAt').val() > now - 1800000)",
            ".validate": "newData.hasChildren(['t', 'from', 'at']) && newData.child('t').isString() && newData.child('t').val().length < 20 && newData.child('from').val().matches(/^[A-F]$/) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000 && (!newData.hasChild('text') || (newData.child('text').isString() && newData.child('text').val().length <= 200))"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "cleanup": {
      "sweptDay": {
        ".read": true,
        ".write": "newData.isNumber() && newData.val() * 86400000 <= now && (!data.exists() || newData.val() > data.val())"
      },
      "days": {
        "$day": {
          ".read": "!data.exists() || data.child('lastAt').val() < now - 21600000",
          ".write": "data.exists() && !newData.exists() && data.child('lastAt').val() < now - 21600000",
          ".validate": "newData.hasChildren(['lastAt'])",
          "lastAt": {
            ".write": "newData.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
          },
          "rooms": {
            "$code": {
              ".write": "$code.matches(/^[A-Z]{4}$/) && !data.exists()",
              ".validate": "newData.isBoolean() && newData.val() == true"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "stats": {
      ".read": "auth != null && auth.uid === 'TrNylkeOFXNhnTPWAApebKvbI3F2'",
      "$env": {
        ".validate": "$env.matches(/^[a-z]{2,10}$/)",
        "days": {
          "$day": {
            ".validate": "$day.matches(/^[0-9]{5}$/)",
            "rooms": {
              "$code": {
                ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $code.matches(/^[A-Z]{4}$/) && !data.exists()",
                ".validate": "newData.hasChildren(['game', 'at', 'v', 'players'])",
                "game": {
                  ".validate": "newData.isString() && newData.val().length < 40"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
                },
                "v": {
                  ".validate": "newData.isString() && newData.val().length <= 16"
                },
                "players": {
                  "$p": {
                    ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $code.matches(/^[A-Z]{4}$/) && $p.matches(/^[A-F]$/) && !data.exists()",
                    ".validate": "newData.isString() && newData.val().length <= 20"
                  }
                },
                "co": {
                  "$p": {
                    ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $code.matches(/^[A-Z]{4}$/) && $p.matches(/^[A-F]$/) && !data.exists()",
                    ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
                  }
                },
                "end": {
                  ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $code.matches(/^[A-Z]{4}$/) && !data.exists()",
                  ".validate": "newData.hasChildren(['winner', 'at'])",
                  "winner": {
                    ".validate": "newData.isString() && newData.val().matches(/^([A-F]|tie)$/)"
                  },
                  "name": {
                    ".validate": "newData.isString() && newData.val().length <= 20"
                  },
                  "at": {
                    ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "local": {
              "$game": {
                "$mode": {
                  "$n": {
                    ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $game.matches(/^[a-z-]{1,40}$/) && $mode.matches(/^[a-z][a-z-]{0,15}$/) && $n.matches(/^[1-9][0-9]?$/)",
                    ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
                  }
                }
              }
            },
            "origin": {
              "$tz": {
                ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $tz.matches(/^[A-Za-z0-9_+-]{1,40}$/)",
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
              }
            },
            "lang": {
              "$lang": {
                ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $lang.matches(/^[A-Za-z0-9_-]{1,12}$/)",
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
              }
            },
            "applang": {
              "$applang": {
                ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $applang.matches(/^[A-Za-z0-9_-]{1,12}$/)",
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
              }
            },
            "hour": {
              "$h": {
                ".write": "$env.matches(/^[a-z]{2,10}$/) && $day.matches(/^[0-9]{5}$/) && $h.matches(/^([0-9]|1[0-9]|2[0-3])$/)",
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || newData.val() == data.val() + 1)"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "torneos": {
      ".read": "auth != null && auth.uid === 'TrNylkeOFXNhnTPWAApebKvbI3F2'",
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z]{5}$/)",
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && !newData.exists() && root.child('torneoSeats/' + $code + '/' + root.child('torneos/' + $code + '/meta/admin').val() + '/' + auth.uid).exists()",
        "meta": {
          ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && (!data.exists() || (root.child('torneoSeats/' + $code + '/' + data.child('admin').val() + '/' + auth.uid).exists() && newData.child('admin').val() == data.child('admin').val() && newData.child('name').val() == data.child('name').val() && newData.child('days').val() == data.child('days').val() && newData.child('cal').val() == data.child('cal').val() && newData.child('createdAt').val() == data.child('createdAt').val() && newData.child('lab').val() == data.child('lab').val() && newData.child('alias').val() == data.child('alias').val() && (data.child('lab').val() == true || (!root.child('torneos/' + $code + '/started').exists() && newData.child('win/1/b').val() > now && newData.child('win/1/a').val() < now + 2764800000))))",
          ".validate": "newData.hasChildren(['v', 'name', 'days', 'start', 'tz', 'admin', 'cal', 'win', 'end', 'joinUntil', 'final', 'createdAt']) && newData.parent().child('players/' + newData.child('admin').val()).exists()",
          "v": {
            ".validate": "newData.isNumber()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "days": {
            ".validate": "newData.isNumber() && (newData.val() == 3 || newData.val() == 7)"
          },
          "start": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "tz": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "admin": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{6}$/)"
          },
          "cal": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "win": {
            "$d": {
              ".validate": "$d.matches(/^[1-7]$/) && newData.hasChildren(['a', 'b', 'h'])",
              "$k": {
                ".validate": "newData.isNumber()"
              }
            }
          },
          "end": {
            ".validate": "newData.isNumber()"
          },
          "joinUntil": {
            ".validate": "newData.isNumber()"
          },
          "final": {
            ".validate": "newData.isString() && newData.val().matches(/^[37]$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((data.exists() && newData.val() == data.val()) || (newData.val() <= now + 60000 && newData.val() > now - 60000))"
          },
          "lab": {
            ".validate": "newData.isBoolean() && newData.val() == true"
          },
          "alias": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9][a-z0-9-]{1,18}[a-z0-9]$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$pid": {
            ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && ((!data.exists() && now < newData.parent().parent().child('meta/joinUntil').val() && newData.parent().parent().child('closed').val() != true && newData.parent().parent().parent().parent().child('torneoSeats/' + $code + '/' + $pid + '/' + auth.uid).exists()) || (data.exists() && newData.exists() && root.child('torneoSeats/' + $code + '/' + root.child('torneos/' + $code + '/meta').child('admin').val() + '/' + auth.uid).exists()))",
            ".validate": "newData.hasChildren(['name', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "out": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "started": {
          "$d": {
            "$pid": {
              ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && $d.matches(/^[1-7]$/) && !data.exists() && root.child('torneoSeats/' + $code + '/' + $pid + '/' + auth.uid).exists() && now >= root.child('torneos/' + $code + '/meta').child('win/' + $d + '/a').val() && now < root.child('torneos/' + $code + '/meta').child('win/' + $d + '/b').val()",
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
            }
          }
        },
        "results": {
          "$d": {
            "$pid": {
              ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && $d.matches(/^[1-7]$/) && !data.exists() && root.child('torneoSeats/' + $code + '/' + $pid + '/' + auth.uid).exists() && now >= root.child('torneos/' + $code + '/meta').child('win/' + $d + '/a').val() && now < root.child('torneos/' + $code + '/meta').child('win/' + $d + '/b').val()",
              ".validate": "newData.hasChildren(['s', 'ms', 't', 'at'])",
              "s": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "ms": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "t": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "r": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "wild": {
          "$pid": {
            ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && !data.exists() && root.child('torneoSeats/' + $code + '/' + $pid + '/' + auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().matches(/^[1-6]$/) && newData.val() != root.child('torneos/' + $code + '/meta').child('final').val() && !root.child('torneos/' + $code + '/started/' + newData.val() + '/' + $pid).exists() && now >= root.child('torneos/' + $code + '/meta').child('win/' + newData.val() + '/a').val() && now < root.child('torneos/' + $code + '/meta').child('win/' + newData.val() + '/b').val()"
          }
        },
        "closed": {
          ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && root.child('torneoSeats/' + $code + '/' + root.child('torneos/' + $code + '/meta/admin').val() + '/' + auth.uid).exists()",
          ".validate": "newData.isBoolean() && newData.val() == true"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "torneoKeys": {
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && !newData.exists() && root.child('torneoSeats/' + $code + '/' + root.child('torneos/' + $code + '/meta/admin').val() + '/' + auth.uid).exists()",
        "$pid": {
          ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && ((!data.exists() && newData.parent().parent().parent().child('torneoSeats/' + $code + '/' + $pid + '/' + auth.uid).exists()) || (data.exists() && root.child('torneoSeats/' + $code + '/' + root.child('torneos/' + $code + '/meta').child('admin').val() + '/' + auth.uid).exists()))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        }
      }
    },
    "torneoSeats": {
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && !newData.exists() && root.child('torneoSeats/' + $code + '/' + root.child('torneos/' + $code + '/meta/admin').val() + '/' + auth.uid).exists()",
        "$pid": {
          ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && !newData.exists() && root.child('torneoSeats/' + $code + '/' + root.child('torneos/' + $code + '/meta').child('admin').val() + '/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{5}$/) && $pid.matches(/^[a-z0-9]{6}$/) && $uid === auth.uid && newData.exists()",
            ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().parent().child('torneoKeys/' + $code + '/' + $pid).val()"
          }
        }
      }
    },
    "torneoAlias": {
      "$alias": {
        ".read": "$alias.matches(/^[a-z0-9][a-z0-9-]{1,18}[a-z0-9]$/)",
        ".write": "auth != null && $alias.matches(/^[a-z0-9][a-z0-9-]{1,18}[a-z0-9]$/) && ((newData.exists() && (!data.exists() || data.child('hasta').val() < now || data.child('code').val() == newData.child('code').val()) && newData.parent().parent().child('torneos/' + newData.child('code').val() + '/meta/alias').val() == $alias && newData.parent().parent().child('torneoSeats/' + newData.child('code').val() + '/' + newData.parent().parent().child('torneos/' + newData.child('code').val() + '/meta/admin').val() + '/' + auth.uid).exists()) || (!newData.exists() && root.child('torneoSeats/' + data.child('code').val() + '/' + root.child('torneos/' + data.child('code').val() + '/meta/admin').val() + '/' + auth.uid).exists()))",
        ".validate": "newData.hasChildren(['code', 'hasta'])",
        "code": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z]{5}$/)"
        },
        "hasta": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() < now + 5184000000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feedback": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['texto', 'at'])",
        "texto": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "contexto": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > now - 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
