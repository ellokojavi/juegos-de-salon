{
  "permissions": {
    "allow": [
      "Bash(node tools/firebase/rules.mjs:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ -f tools/agents/clean-worktrees.mjs ] && node tools/agents/clean-worktrees.mjs --hook || true",
            "timeout": 60,
            "statusMessage": "Checking merged worktrees…"
          }
        ]
      }
    ]
  }
}
